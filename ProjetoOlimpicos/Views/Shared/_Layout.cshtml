<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoOlimpicos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjetoOlimpicos.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ProjetoOlimpicos</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <nav class="collapse navbar-collapse" id="topNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <!-- Usuário logado -->
                            <span>Bem-vindo, @Context.Session.GetString("Username")!</span>
                            
                        }
                        <li class="nav-item"><a class="nav-link" asp-controller="Edicao" asp-action="Index">Edições</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Atletas" asp-action="Index">Atletas</a></li>
                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <!-- Usuário logado -->
                           
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Logout">Logout</a></li>
                            
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">Cadastros</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Modalidades" asp-action="Criar">Modalidades</a></li>
                                    <li><a class="dropdown-item" asp-controller="Provas" asp-action="Criar">Provas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Estados" asp-action="Criar">Estados</a></li>
                                    <li><a class="dropdown-item" asp-controller="Cidades" asp-action="Criar">Cidades</a></li>
                                    <li><a class="dropdown-item" asp-controller="Atletas" asp-action="Criar">Cadastrar Atleta</a></li>
                                    <li><a class="dropdown-item" asp-controller="ResultadosAtletas" asp-action="Criar">Cadastrar Resultados</a></li>
                                    <li><a class="dropdown-item" asp-controller="Edicao" asp-action="Criar">Cadastrar Edição</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Usuário não logado -->
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Login">Login</a></li>

                        }

                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="NovoUsuario">Novo Usuário</a></li>
                      
                    </ul>


                </nav>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ProjetoOlimpicos - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
