<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Olympic Editorial</title>
    
    <!-- Design System Global -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    
    <!-- Tipografia - Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;700;900&family=Inter:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
</head>
<body>
    <!-- HEADER / NAVEGAÇÃO PRINCIPAL -->
    <header class="header-editorial">
        <nav class="navbar-editorial">
            <div class="container-fluid">
                <!-- Logo / Branding -->
                <div class="navbar-brand">
                    <a href="@Url.Action("Index", "Home")" class="brand-logo">

                        <span class="brand-text">OLYMPIC EDITORIAL</span>
                    </a>
                </div>
                
                <!-- Navegação Central -->
                <nav class="navbar-menu">
                    <a href="@Url.Action("Index", "Edicao")" class="nav-link">Edições</a>
                    <a href="@Url.Action("Index", "Atletas")" class="nav-link">Atletas</a>
                    <a href="@Url.Action("Index", "Provas")" class="nav-link">Provas</a>
                    <a href="@Url.Action("Index", "Modalidades")" class="nav-link">Modalidades</a>
                    <a href="@Url.Action("Index", "Cidades")" class="nav-link">Cidades</a>
                    <a href="@Url.Action("Index", "Estados")" class="nav-link">Estados</a>
                    <a href="@Url.Action("Index", "ResultadosAtletas")" class="nav-link">Resultados</a>
                </nav>
                
                <!-- Navegação de Usuário -->
                <nav class="navbar-user">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <span class="user-greeting">
                            <span class="text-metadata">Bem-vindo,</span>
                            <strong>@Context.Session.GetString("Username")</strong>
                        </span>
                        
                        @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Gerente")
                        {
                            <div class="nav-dropdown">
                                <button class="btn-dropdown" aria-expanded="false" aria-label="Menu Administrativo">
                                    <span class="text-metadata">Gestão</span>
                                </button>
                                <ul class="dropdown-menu" style="display: none;">
                                    @if (Context.Session.GetString("Role") == "Admin")
                                    {
                                        <li><a href="@Url.Action("Index", "Admin")">Painel Admin</a></li>
                                        <li><a href="@Url.Action("NovoUsuario", "Admin")">Novo Utilizador</a></li>
                                        <li style="border-top: 2px solid var(--color-gray-admin);"></li>
                                    }
                                    <li><a href="@Url.Action("Criar", "Edicao")">Nova Edição</a></li>
                                    <li><a href="@Url.Action("Criar", "Atletas")">Novo Atleta</a></li>
                                    <li><a href="@Url.Action("Criar", "Provas")">Nova Prova</a></li>
                                    <li><a href="@Url.Action("Criar", "Modalidades")">Nova Modalidade</a></li>
                                    <li><a href="@Url.Action("Criar", "ResultadosAtletas")">Novo Resultado</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="nav-dropdown">
                                <button class="btn-dropdown" aria-expanded="false" aria-label="Menu do Utilizador">
                                    <span class="text-metadata">Menu</span>
                                </button>
                                <ul class="dropdown-menu" style="display: none;">
                                    <li><a href="@Url.Action("Index", "Edicao")">Ver Edições</a></li>
                                    <li><a href="@Url.Action("Index", "Atletas")">Ver Atletas</a></li>
                                    <li><a href="@Url.Action("Index", "Provas")">Ver Provas</a></li>
                                </ul>
                            </div>
                        }
                        
                        <a href="@Url.Action("Logout", "Admin")" class="btn btn-ghost">Logout</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Admin")" class="btn btn-primary">Login</a>
                        <a href="@Url.Action("Registrar", "Admin")" class="btn btn-ghost">Criar Conta</a>
                    }
                </nav>
            </div>
        </nav>
    </header>

    <!-- CONTEÚDO PRINCIPAL -->
    <main role="main" class="main-content">
        <div class="container">
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger" style="margin-bottom: 20px; padding: 15px; background-color: #fee; border-left: 5px solid #dc3545; border-radius: 4px; color: #721c24;">
                    @TempData["Erro"]
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="footer-editorial">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2026 - Olympic Editorial. Todos os direitos reservados.</p>
                <nav class="footer-links">
                    <a href="@Url.Action("Privacy", "Home")">Privacidade</a>
                    <a href="#">Termos de Uso</a>
                    <a href="#">Contato</a>
                </nav>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- Script para Dropdown -->
    <script>
        document.querySelectorAll('.btn-dropdown').forEach(btn => {
            btn.addEventListener('click', function() {
                const menu = this.nextElementSibling;
                const isOpen = menu.style.display === 'block';
                menu.style.display = isOpen ? 'none' : 'block';
                this.setAttribute('aria-expanded', !isOpen);
            });
        });
        
        // Fechar dropdown ao clicar fora
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.nav-dropdown')) {
                document.querySelectorAll('.dropdown-menu').forEach(menu => {
                    menu.style.display = 'none';
                });
                document.querySelectorAll('.btn-dropdown').forEach(btn => {
                    btn.setAttribute('aria-expanded', 'false');
                });
            }
        });
    </script>
</body>
</html>
