@model ProjetoOlimpicos.Models.Provas
@{
    ViewBag.Title = "Editar Prova - Olympic Editorial";
}

<div class="login-container">
    <div class="login-wrapper">
        <div class="login-header">
            <h1 class="login-title">Editar Prova</h1>
            <p class="login-subtitle">Atualize os detalhes da competição</p>
        </div>

        <form asp-action="Editar" method="post" class="login-form">
            <input type="hidden" asp-for="codProva" />

            <div class="form-group">
                <label class="form-label">Nome da Prova</label>
                <input asp-for="prova" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">Modalidade</label>
                <select asp-for="codModalidade" class="form-control" asp-items="@(new SelectList(ViewBag.Modalidades, "codModalidade", "nomeModalidade"))" required>
                </select>
            </div>

            <div class="form-actions" style="margin-top: 20px; display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Salvar Alterações</button>
                <a href="@Url.Action("Index")" class="btn btn-ghost" style="flex: 1; text-align: center;">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<style>
    .login-container { display: flex; align-items: center; justify-content: center; min-height: 70vh; padding: 40px 0; }
    .login-wrapper { background: var(--color-white-galactic); border: 1px solid var(--color-gray-admin); border-radius: var(--radius-lg); padding: var(--spacing-2xl); width: 100%; max-width: 500px; box-shadow: var(--shadow-lg); }
    .login-header { text-align: center; margin-bottom: var(--spacing-xl); }
    .login-title { font-family: var(--font-heading); font-size: var(--font-size-2xl); font-weight: var(--font-weight-black); text-transform: uppercase; color: var(--color-black-editorial); }
    .login-form { display: flex; flex-direction: column; gap: var(--spacing-md); }
    .form-label { font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); text-transform: uppercase; color: var(--color-gray-metadata); margin-bottom: 4px; display: block; }
    .form-control { width: 100%; padding: 10px; border: 1px solid var(--color-gray-admin); border-radius: var(--radius-sm); }
</style>
