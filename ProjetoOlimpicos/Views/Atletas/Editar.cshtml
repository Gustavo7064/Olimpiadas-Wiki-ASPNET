@model ProjetoOlimpicos.Models.Atletas
@{
    ViewBag.Title = "Editar Atleta - Olympic Editorial";
}

<div class="login-container">
    <div class="login-wrapper">
        <div class="login-header">
            <h1 class="login-title">Editar Atleta</h1>
            <p class="login-subtitle">Atualize as informações do competidor</p>
        </div>

        <form asp-action="Editar" method="post" class="login-form">
            <input type="hidden" asp-for="CodAtleta" />

            <div class="form-group">
                <label class="form-label">Nome Completo</label>
                <input asp-for="NomeAtleta" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">Data de Nascimento</label>
                <input asp-for="DataNascimento" class="form-control" placeholder="DD/MM/AAAA" required />
            </div>

            <div class="form-group">
                <label class="form-label">Sexo</label>
                <select asp-for="Sexo" class="form-control" required>
                    <option value="M">Masculino</option>
                    <option value="F">Feminino</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Altura (cm)</label>
                <input asp-for="Altura" type="number" step="0.01" class="form-control" />
            </div>

            <div class="form-group">
                <label class="form-label">Peso (kg)</label>
                <input asp-for="Peso" type="number" step="0.01" class="form-control" />
            </div>

            <div class="form-group">
                <label class="form-label">Cidade</label>
                <select asp-for="CodCidade" class="form-control" asp-items="@(new SelectList(ViewBag.Cidades, "CodCidade", "NomeCidade"))" required>
                </select>
            </div>

            <div class="form-actions" style="margin-top: 20px; display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Salvar Alterações</button>
                <a href="@Url.Action("Index")" class="btn btn-ghost" style="flex: 1; text-align: center;">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<style>
    /* Reaproveitando estilos do login para consistência */
    .login-container { display: flex; align-items: center; justify-content: center; min-height: 80vh; padding: 40px 0; }
    .login-wrapper { background: var(--color-white-galactic); border: 1px solid var(--color-gray-admin); border-radius: var(--radius-lg); padding: var(--spacing-2xl); width: 100%; max-width: 500px; box-shadow: var(--shadow-lg); }
    .login-header { text-align: center; margin-bottom: var(--spacing-xl); }
    .login-title { font-family: var(--font-heading); font-size: var(--font-size-2xl); font-weight: var(--font-weight-black); text-transform: uppercase; color: var(--color-black-editorial); }
    .login-form { display: flex; flex-direction: column; gap: var(--spacing-md); }
    .form-label { font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); text-transform: uppercase; color: var(--color-gray-metadata); margin-bottom: 4px; display: block; }
    .form-control { width: 100%; padding: 10px; border: 1px solid var(--color-gray-admin); border-radius: var(--radius-sm); }
</style>
