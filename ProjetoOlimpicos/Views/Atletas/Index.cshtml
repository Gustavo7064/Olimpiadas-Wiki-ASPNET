@model List<ProjetoOlimpicos.Models.Atletas>

<h2>Atletas Olímpicos</h2>

<ul>
    @foreach (var atletas in Model)
    {
        <li>
            <a href="/Provas/Criar/@atletas.CodAtleta">
                @atletas.NomeAtleta -  @atletas.DataNascimento - @atletas.Sexo - @atletas.Altura - @atletas.Peso - @atletas.CodCidade
            </a>
        </li>
    }
</ul>