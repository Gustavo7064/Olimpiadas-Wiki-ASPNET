@model ProjetoOlimpicos.Models.Usuario
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar Usuário";
}

<div class="login-container">
    <div class="login-wrapper">
        <div class="login-header">
            <h1 class="login-title">Editar Usuário</h1>
            <p class="login-subtitle">Alterar dados de @Model.Username</p>
        </div>

        <form action="@Url.Action("EditarUsuario", "Admin")" method="post" class="login-form">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group">
                <label for="Username" class="form-label">Nome de Usuário</label>
                <input type="text" id="Username" name="Username" class="form-input" value="@Model.Username" required />
            </div>

            <div class="form-group">
                <label for="newPassword" class="form-label">Nova Senha (deixe em branco para não alterar)</label>
                <input type="password" id="newPassword" name="newPassword" class="form-input" placeholder="Nova senha" />
            </div>

            <div class="form-group">
                <label for="Role" class="form-label">Perfil de Acesso</label>
                <select id="Role" name="Role" class="form-input">
                    @foreach (var role in ViewBag.Roles as string[])
                    {
                        <!option value="@role" @(Model.Role == role ? "selected" : "")>@role</!option>
                    }
                </select>
            </div>

            <div class="form-group" style="display: flex; align-items: center; gap: 10px;">
                <input type="checkbox" id="Ativo" name="Ativo" value="true" @(Model.Ativo ? "checked" : "") style="width: 20px; height: 20px;" />
                <input type="hidden" name="Ativo" value="false" />
                <label for="Ativo" class="form-label" style="margin: 0;">Conta Ativa</label>
            </div>

            <div style="display: flex; gap: var(--spacing-md); margin-top: var(--spacing-lg);">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Salvar Alterações</button>
                <a href="@Url.Action("Index", "Admin")" class="btn btn-ghost" style="flex: 1; text-align: center;">Cancelar</a>
            </div>
        </form>
    </div>
</div>
