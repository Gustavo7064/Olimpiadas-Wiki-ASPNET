@model List<ProjetoOlimpicos.Models.Edicao>

@{
    ViewData["Title"] = "Edições Olímpicas - Olympic Editorial Rebirth";
}

<div class="edicoes-page">
    <!-- Header da Página -->
    <header class="page-header">
        <div class="page-header-content">
            <h1 class="page-title">Edições Olímpicas</h1>
            <p class="page-subtitle">Histórico completo das Olimpíadas cadastradas no portal</p>
        </div>
        
        @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Gerente")
        {
            <a href="@Url.Action("Criar", "Edicao")" class="btn btn-primary">+ Nova Edição</a>
        }
    </header>

    <!-- Conteúdo Principal -->
    <div class="editorial-grid">
        <!-- Left Rail: Timeline -->
        <aside class="rail-left">
            <nav class="timeline-sidebar">
                <h3 class="sidebar-title">Linha do Tempo</h3>
                
                @if (Model != null && Model.Count > 0)
                {
                    <ul class="timeline-list">
                        @foreach (var edicao in Model.OrderByDescending(e => e.Ano))
                        {
                            <li class="timeline-item">
                                <a href="#edicao-@edicao.Codedicao" class="timeline-link">
                                    <span class="timeline-year">@edicao.Ano</span>
                                    <span class="timeline-sede">@edicao.Sede</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </nav>
        </aside>

        <!-- Center Stage: Edições -->
        <section class="stage-center">
            @if (Model != null && Model.Count > 0)
            {
                <div class="edicoes-stats">
                    <div class="stat-item">
                        <span class="stat-label">Total de Edições</span>
                        <span class="stat-value">@Model.Count</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Ano Mais Antigo</span>
                        <span class="stat-value">@Model.Min(e => e.Ano)</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Ano Mais Recente</span>
                        <span class="stat-value">@Model.Max(e => e.Ano)</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Cidades</span>
                        <span class="stat-value">@Model.Select(e => e.Sede).Distinct().Count()</span>
                    </div>
                </div>

                <ul class="editorial-list edicoes-list">
                    @foreach (var edicao in Model.OrderByDescending(e => e.Ano))
                    {
                        <li class="editorial-list-item edicao-item" id="edicao-@edicao.Codedicao">
                            <!-- Imagem Hero -->
                            <div class="edicao-hero">
                                <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=400&h=300&fit=crop" 
                                     alt="Olimpíadas @edicao.Ano" 
                                     class="edicao-hero-image" />
                                <div class="edicao-hero-overlay"></div>
                                <div class="edicao-hero-badge">
                                    <span class="badge-year">@edicao.Ano</span>
                                </div>
                            </div>

                            <!-- Conteúdo -->
                            <div class="editorial-list-item-main">
                                <h3 class="editorial-list-item-title">Olimpíadas @edicao.Ano</h3>
                                
                                <div class="editorial-list-item-meta">
                                    <span class="badge badge-gold">@edicao.Sede</span>
                                    <span class="text-metadata">Edição #@edicao.Codedicao</span>
                                </div>

                                <p class="editorial-list-item-description">
                                    Confira todos os atletas, provas, modalidades e resultados da edição de @edicao.Ano realizada em @edicao.Sede. 
                                    Acesse os detalhes completos, rankings de atletas e estatísticas de participação.
                                </p>

                                <div class="edicao-actions">
                                    <a href="@Url.Action("Atletas", "Edicao", new { id = edicao.Codedicao })" class="action-link">
                                        <span>Ver Atletas</span>
                                        <span class="icon">→</span>
                                    </a>
                                </div>
                            </div>

                            <!-- Ações -->
                            <div class="editorial-list-item-action" style="display: flex; flex-direction: column; gap: 10px;">
                                <a href="@Url.Action("Atletas", "Edicao", new { id = edicao.Codedicao })" class="btn btn-primary">Explorar</a>
                                
                                @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Gerente")
                                {
                                    <a href="@Url.Action("Editar", "Edicao", new { id = edicao.Codedicao })" class="btn btn-ghost">Editar</a>
                                }
                                
                                @if (Context.Session.GetString("Role") == "Admin")
                                {
                                    <form asp-action="Excluir" asp-route-id="@edicao.Codedicao" method="post" onsubmit="return confirm('Tem certeza que deseja excluir esta edição? Todos os atletas e resultados vinculados podem ser afetados.');">
                                        <button type="submit" class="btn btn-ghost" style="color: var(--color-gold-emblem); width: 100%;">Excluir</button>
                                    </form>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-state">
                    <p class="empty-state-icon"></p>
                    <p class="empty-state-text">Nenhuma edição olímpica cadastrada ainda.</p>
                    @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Gerente")
                    {
                        <a href="@Url.Action("Criar", "Edicao")" class="btn btn-primary mt-lg">Cadastrar Primeira Edição</a>
                    }
                </div>
            }
        </section>

        <!-- Right Insight: Estatísticas -->
        <aside class="insight-right">
            @if (Model != null && Model.Count > 0)
            {
                <!-- Edições por Década -->
                <article class="editorial-card">
                    <h3 class="editorial-card-title">Distribuição Temporal</h3>
                    <ul class="ranking-list">
                        @foreach (var decada in Model
                            .GroupBy(e => (e.Ano / 10) * 10)
                            .OrderByDescending(g => g.Key))
                        {
                            <li class="ranking-item">
                                <div class="ranking-position"></div>
                                <div class="ranking-content">
                                    <div class="ranking-name">Anos @decada.Key-@(decada.Key + 9)</div>
                                </div>
                                <div class="ranking-value">@decada.Count()</div>
                            </li>
                        }
                    </ul>
                </article>

                <!-- Cidades Anfitriãs -->
                <article class="editorial-card">
                    <h3 class="editorial-card-title">Cidades Anfitriãs</h3>
                    <ul class="ranking-list">
                        @foreach (var cidade in Model
                            .GroupBy(e => e.Sede)
                            .OrderByDescending(g => g.Count()))
                        {
                            <li class="ranking-item">
                                <div class="ranking-position"></div>
                                <div class="ranking-content">
                                    <div class="ranking-name">@cidade.Key</div>
                                </div>
                                <div class="ranking-value">@cidade.Count()</div>
                            </li>
                        }
                    </ul>
                </article>

                <!-- Informações -->
                <article class="editorial-card">
                    <h3 class="editorial-card-title">Período Coberto</h3>
                    <div class="quick-fact">
                        <div class="quick-fact-label">Início</div>
                        <div class="quick-fact-value">@Model.Min(e => e.Ano)</div>
                    </div>
                    <div class="quick-fact">
                        <div class="quick-fact-label">Fim</div>
                        <div class="quick-fact-value">@Model.Max(e => e.Ano)</div>
                    </div>
                    <div class="quick-fact">
                        <div class="quick-fact-label">Intervalo</div>
                        <div class="quick-fact-value">@(Model.Max(e => e.Ano) - Model.Min(e => e.Ano)) <span class="quick-fact-unit">anos</span></div>
                    </div>
                </article>
            }
        </aside>
    </div>
</div>

<style>
    .edicoes-page {
        padding: var(--spacing-2xl) 0;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: var(--spacing-3xl);
        padding-bottom: var(--spacing-xl);
        border-bottom: 1px solid var(--color-gray-admin);
        gap: var(--spacing-lg);
    }

    .page-header-content {
        flex: 1;
    }

    .page-title {
        font-family: var(--font-heading);
        font-size: var(--font-size-4xl);
        font-weight: var(--font-weight-black);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-tight);
        color: var(--color-black-editorial);
        margin: 0 0 var(--spacing-sm) 0;
    }

    .page-subtitle {
        font-size: var(--font-size-sm);
        color: var(--color-gray-metadata);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-wide);
        margin: 0;
    }

    .page-header .btn {
        flex-shrink: 0;
    }

    .timeline-sidebar {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
    }

    .sidebar-title {
        font-family: var(--font-heading);
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-black);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-tight);
        color: var(--color-black-editorial);
        margin: 0;
    }

    .timeline-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
        border-left: 2px solid var(--color-gray-admin);
        padding-left: var(--spacing-lg);
    }

    .timeline-item {
        position: relative;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: calc(-1 * var(--spacing-lg) - 1px);
        top: 8px;
        width: 12px;
        height: 12px;
        background-color: var(--color-blue-abyssal);
        border-radius: 50%;
        border: 2px solid var(--color-white-galactic);
    }

    .timeline-link {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
        padding: var(--spacing-sm);
        border-radius: var(--radius-sm);
        transition: all var(--transition-base);
    }

    .timeline-link:hover {
        background-color: var(--color-gray-snow);
    }

    .timeline-year {
        font-family: var(--font-heading);
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-black);
        color: var(--color-black-editorial);
    }

    .timeline-sede {
        font-size: var(--font-size-sm);
        color: var(--color-gray-metadata);
    }

    .edicoes-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-2xl);
        padding: var(--spacing-lg);
        background-color: var(--color-gray-snow);
        border-radius: var(--radius-md);
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .stat-label {
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-wide);
        color: var(--color-gray-metadata);
    }

    .stat-value {
        font-family: var(--font-heading);
        font-size: var(--font-size-2xl);
        font-weight: var(--font-weight-black);
        color: var(--color-blue-abyssal);
    }

    .edicoes-list {
        margin-top: var(--spacing-2xl);
    }

    .edicao-item {
        display: grid;
        grid-template-columns: 300px 1fr auto;
        gap: var(--spacing-lg);
        align-items: center;
        padding: var(--spacing-lg);
        background-color: var(--color-gray-snow);
        border-radius: var(--radius-md);
        margin-bottom: var(--spacing-lg);
    }

    .edicao-hero {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-md);
        height: 200px;
    }

    .edicao-hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .edicao-hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(0, 31, 63, 0.4), rgba(212, 175, 55, 0.3));
    }

    .edicao-hero-badge {
        position: absolute;
        top: var(--spacing-md);
        right: var(--spacing-md);
    }

    .badge-year {
        display: inline-block;
        background-color: var(--color-gold-medal);
        color: var(--color-black-editorial);
        padding: var(--spacing-sm) var(--spacing-md);
        font-family: var(--font-heading);
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-black);
        border-radius: var(--radius-sm);
    }

    .edicao-actions {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-md);
    }

    .action-link {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-wide);
        color: var(--color-blue-abyssal);
        transition: all var(--transition-base);
    }

    .action-link:hover {
        color: var(--color-gold-medal);
    }

    .action-link .icon {
        display: inline-block;
        transition: transform var(--transition-base);
    }

    .action-link:hover .icon {
        transform: translateX(4px);
    }

    .empty-state {
        padding: var(--spacing-3xl);
        background-color: var(--color-gray-snow);
        border-radius: var(--radius-md);
        text-align: center;
    }

    .empty-state-icon {
        font-size: 3rem;
        margin: 0 0 var(--spacing-md) 0;
    }

    .empty-state-text {
        font-size: var(--font-size-base);
        color: var(--color-gray-metadata);
        margin: 0 0 var(--spacing-lg) 0;
    }

    @@media (max-width: 1024px) {
        .edicao-item {
            grid-template-columns: 1fr;
        }

        .edicao-hero {
            height: 250px;
        }
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
        }

        .edicoes-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
