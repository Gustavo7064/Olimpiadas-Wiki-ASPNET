@model ProjetoOlimpicos.Models.ResultadosAtletas
@{
    ViewBag.Title = "Cadastro de Resultado";
}

<style>
    .form-container {
        width: 500px;
        margin: 50px auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    h2 { text-align: center; margin-bottom: 20px; color: #333; }
    label { display: block; margin-top: 10px; color: #444; }
    input[type="text"], input[type="number"], select {
        width: 100%; padding: 10px; margin-top: 5px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box;
    }
    button {
        margin-top: 20px; width: 100%; padding: 12px; background-color: #4CAF50; color: white; font-weight: bold; border: none; border-radius: 5px; cursor: pointer;
    }
    button:hover { background-color: #45a049; }
</style>

<div class="form-container">
    <h2>Cadastrar Resultado</h2>

    <form asp-action="Criar" method="post">
        @Html.AntiForgeryToken()

        <label>Atleta:</label>
        <select asp-for="codAtleta"
                asp-items="@(new SelectList(ViewBag.Atletas, "CodAtleta", "NomeAtleta"))"
                required>
            <option value="">Selecione o atleta</option>
        </select>

        <label>Prova:</label>
        <select asp-for="codProva"
                asp-items="@(new SelectList(ViewBag.Provas, "codProva", "prova"))"
                required>
            <option value="">Selecione a prova</option>
        </select>

        <label>Edição:</label>
        <select asp-for="edicao"
                asp-items="@(new SelectList(ViewBag.Edicoes, "Codedicao", "Ano"))"
                required>
            <option value="">Selecione a edição</option>
        </select>

        <label>Resultado (ex: 1ºLugar):</label>
        <input asp-for="resultado" type="text" />

        <label>Medalha (ex: Ouro, Prata, Bronze):</label>
        <input asp-for="medalha" type="text" />

        <button type="submit">Cadastrar</button>
    </form>
</div>
